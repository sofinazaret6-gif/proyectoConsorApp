<Window x:Class="consorApp.Views.AvisosPropietarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Avisos del Consorcio - ConsorApp"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="ColorGrisOscuro"
                         Color="#2E363A"/>

        <SolidColorBrush x:Key="ColorTaupeBronce"
                         Color="#A09285"/>

        <SolidColorBrush x:Key="ColorGrisClaro"
                         Color="#F7F5F2"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#777777"/>

    </Window.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <Grid Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Avisos y Comunicados"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorGrisOscuro}"/>

                    <TextBlock Text="Consulte los comunicados generales del consorcio y las notificaciones dirigidas a su unidad."
                               FontSize="13"
                               Foreground="{StaticResource ColorTextoSecundario}"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- LISTA DINÁMICA DE AVISOS -->
            <!-- ================================================= -->

            <ItemsControl x:Name="ItemsAvisos">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Background="{StaticResource ColorGrisClaro}"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,15"
                    BorderBrush="#E5E0DA"
                    BorderThickness="1">

                            <StackPanel>

                                <Grid Margin="0,0,0,10">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">

                                        <Border Background="#A09285"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    Margin="0,0,10,0">

                                            <TextBlock Text="AVISO"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"/>

                                        </Border>

                                        <TextBlock Text="{Binding titulo}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ColorGrisOscuro}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                   Text="{Binding fechaPublicacion, StringFormat='Publicado: {0:dd/MM/yyyy - HH:mm} hs'}"
                                   FontSize="12"
                                   Foreground="{StaticResource ColorTextoSecundario}"
                                   VerticalAlignment="Center"/>

                                </Grid>

                                <TextBlock Text="{Binding mensaje}"
                               FontSize="13"
                               Foreground="#444444"
                               TextWrapping="Wrap"
                               Margin="0,5,0,10"/>

                                <Separator Background="#E5E0DA"
                               Margin="0,5"/>

                                <TextBlock Text="Publicado por: Encargado de Edificio"
                               FontSize="11"
                               Foreground="#888888"
                               FontStyle="Italic"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>


            <!-- ================================================= -->
            <!-- MENSAJE CUANDO NO HAY AVISOS -->
            <!-- ================================================= -->

            <TextBlock x:Name="TxtSinAvisos"
                       Text="No hay avisos para mostrar."
                       FontSize="14"
                       Foreground="{StaticResource ColorTextoSecundario}"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,0"
                       Visibility="Collapsed"/>

        </StackPanel>

    </ScrollViewer>

</Window>