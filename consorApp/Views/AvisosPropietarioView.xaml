<Window x:Class="consorApp.Views.AvisosPropietarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Avisos del Consorcio - ConsorApp"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="ColorGrisOscuro"
                         Color="#2E363A"/>

        <SolidColorBrush x:Key="ColorTaupeBronce"
                         Color="#A09285"/>

        <SolidColorBrush x:Key="ColorGrisClaro"
                         Color="#F7F5F2"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#777777"/>

    </Window.Resources>


    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <Grid Margin="0,0,0,20">

                <StackPanel>

                    <TextBlock Text="Avisos y Comunicados"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorGrisOscuro}"/>

                    <TextBlock Text="Consulte los comunicados generales del consorcio y las notificaciones dirigidas a su unidad."
                               FontSize="13"
                               Foreground="{StaticResource ColorTextoSecundario}"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- LISTA DINÁMICA DE AVISOS -->
            <!-- ================================================= -->

            <ItemsControl x:Name="ItemsAvisos">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <!-- Azul = aviso general / Naranja = aviso para este propietario -->
                        <Border CornerRadius="8" Margin="0,0,0,15" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F3F8FD"/>
                                    <Setter Property="BorderBrush" Value="#C9DCEE"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsGeneral}" Value="False">
                                            <Setter Property="Background" Value="#FFF7EC"/>
                                            <Setter Property="BorderBrush" Value="#F0D3AA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Franja de color -->
                                <Border Grid.Column="0" CornerRadius="7,0,0,7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#4A7FB5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsGeneral}" Value="False">
                                                    <Setter Property="Background" Value="#C9822B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="16,14,16,14">

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <WrapPanel Grid.Column="0">

                                            <!-- GENERAL / PARA TI -->
                                            <Border CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#4A7FB5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsGeneral}" Value="False">
                                                                <Setter Property="Background" Value="#C9822B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding EtiquetaPropietario}"
                                               Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>

                                            <!-- NUEVO -->
                                            <Border Background="#27AE60" CornerRadius="4"
                                        Padding="8,3" Margin="0,0,8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="NUEVO" Foreground="White"
                                               FontSize="11" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Título -->
                                            <TextBlock Text="{Binding Titulo}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource ColorGrisOscuro}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        </WrapPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding FechaTexto}"
                                       FontSize="12"
                                       Foreground="{StaticResource ColorTextoSecundario}"
                                       VerticalAlignment="Top" Margin="12,3,0,0"/>
                                    </Grid>

                                    <TextBlock Text="{Binding Mensaje}"
                                   FontSize="13" Foreground="#444444"
                                   TextWrapping="Wrap" Margin="0,5,0,10"/>

                                    <Separator Background="#E5E0DA" Margin="0,5"/>

                                    <TextBlock Text="Publicado por: Encargado de Edificio"
                                   FontSize="11" Foreground="#888888" FontStyle="Italic"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <!-- ================================================= -->
            <!-- MENSAJE CUANDO NO HAY AVISOS -->
            <!-- ================================================= -->

            <TextBlock x:Name="TxtSinAvisos"
                       Text="No hay avisos para mostrar."
                       FontSize="14"
                       Foreground="{StaticResource ColorTextoSecundario}"
                       HorizontalAlignment="Center"
                       Margin="0,30,0,0"
                       Visibility="Collapsed"/>

        </StackPanel>

    </ScrollViewer>

</Window>