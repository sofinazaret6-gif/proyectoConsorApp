<Window x:Class="consorApp.Views.LiquidacionExpensasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liquidación de Expensas"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <TextBlock Text="Módulo de Liquidación de Expensas"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#333"
                   Margin="0,0,0,15"/>

        <TabControl Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDD">

            <TabItem Header="Registrar Gastos" Padding="10,5">
                <Grid Margin="20,15,20,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Registrar gasto del edificio"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- FORMULARIO -->
                    <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#DDD"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Concepto" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbConceptoGasto" Height="28"
                              DisplayMemberPath="nombreConcepto"/>
                            </StackPanel>

                            <Button Grid.Row="0" Grid.Column="1" Content="+ Nuevo"
                        Height="28" Padding="10,0" VerticalAlignment="Bottom"
                        Margin="6,0,15,0" Click="BtnNuevoConcepto_Click"/>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Monto" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtMontoGasto" Height="28"
                             VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Período (MM/aaaa)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtPeriodoGasto" Height="28"
                             VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="Fecha" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <DatePicker x:Name="DpFechaGasto" Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                            Margin="0,10,15,0">
                                <TextBlock Text="Descripción (opcional)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtDescripcionGasto"
                             MinHeight="28" MaxHeight="60"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Row="1" Grid.Column="4" Content="GUARDAR GASTO"
                        Height="28" VerticalAlignment="Bottom"
                        FontWeight="Bold" Click="BtnGuardarGasto_Click"/>
                        </Grid>
                    </Border>

                    <!-- FILTROS -->
                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Período" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtFiltroPeriodoGasto" Width="90" Height="28"
                         VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Concepto" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbFiltroConcepto" Width="200" Height="28"
                          DisplayMemberPath="nombreConcepto"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Desde" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <DatePicker x:Name="DpFiltroDesde" Width="130" Height="28"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,15,0">
                            <TextBlock Text="Hasta" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <DatePicker x:Name="DpFiltroHasta" Width="130" Height="28"/>
                        </StackPanel>

                        <Button Content="Filtrar" Width="80" Height="28"
                    VerticalAlignment="Bottom" Margin="0,0,8,0"
                    Click="BtnFiltrarGastos_Click"/>
                        <Button Content="Limpiar" Width="80" Height="28"
                    VerticalAlignment="Bottom"
                    Click="BtnLimpiarFiltrosGastos_Click"/>
                    </WrapPanel>

                    <!-- TABLA -->
                    <DataGrid x:Name="DgGastos" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding fecha, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Concepto"
                                    Binding="{Binding ConceptoGasto.nombreConcepto}" Width="180"/>
                            <DataGridTextColumn Header="Descripción"
                                    Binding="{Binding descripcion}" Width="*"/>
                            <DataGridTextColumn Header="Período"
                                    Binding="{Binding periodo}" Width="100"/>
                            <DataGridTextColumn Header="Monto"
                                    Binding="{Binding monto, StringFormat={}{0:C2}}" Width="120"/>
                            <DataGridTextColumn Header="Estado"
                                    Binding="{Binding estado}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- TOTAL -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="Total filtrado:" FontWeight="SemiBold" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="LblTotalGastos" Text="$ 0,00" FontWeight="Bold"
                       FontSize="16" Foreground="#2E7D32" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================================================== -->
            <!-- PESTAÑA 1 - LIQUIDAR EXPENSAS -->
            <!-- ===================================================== -->

            <TabItem Header="Liquidar Expensas" Padding="10,5">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- PERÍODO -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Período (MM/aaaa):" FontSize="14" FontWeight="Bold"
                   VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPeriodoLiquidar" Width="100" Height="30" FontSize="14"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Margin="10,0"/>
                        <Button x:Name="BtnCalcular" Content="Calcular" Width="110" Height="30"
                    Background="#27AE60" Foreground="White" FontWeight="Bold"
                    Click="BtnCalcular_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DATOS DE LA LIQUIDACIÓN -->
                        <Border Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0"
                    Background="#F8F9FA" BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Datos de la Liquidación" FontSize="17" FontWeight="Bold"
                               Foreground="#1E293B" HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                                <TextBlock Text="Total de gastos del período:" FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtMontoTotalGastos" IsReadOnly="True" Height="30"
                             VerticalContentAlignment="Center" Background="#F0F0F0"
                             Margin="0,0,0,12"/>

                                <TextBlock Text="Fecha de vencimiento:" FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                                <DatePicker x:Name="DpFechaVencimiento" Height="30" Margin="0,0,0,12"/>

                                <TextBlock Text="Departamentos con propietario:" FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                                <TextBlock x:Name="LblDeptosPropietario" Text="0" FontSize="16"
                               FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>

                                <Separator Margin="0,0,0,10"/>

                                <TextBlock Text="Expensa individual:" FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                                <TextBlock x:Name="LblExpensaIndividual" Text="$ 0,00" FontSize="24"
                               FontWeight="Bold" Foreground="#2E7D32"
                               HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                <Button x:Name="BtnGuardarLiquidacion" Content="Guardar Liquidación"
                            Height="32" Background="#2C3E50" Foreground="White"
                            FontWeight="Bold" Click="BtnGuardarLiquidacion_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- EXPENSAS YA LIQUIDADAS -->
                        <DataGrid x:Name="DgExpensas" Grid.Column="1"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="90"/>
                                <DataGridTextColumn Header="Total gastos"
                                        Binding="{Binding MontoTotalGastos, StringFormat={}{0:C2}}" Width="*"/>
                                <DataGridTextColumn Header="Expensa individual"
                                        Binding="{Binding ValorExpensaIndividual, StringFormat={}{0:C2}}" Width="*"/>
                                <DataGridTextColumn Header="Fecha emisión"
                                        Binding="{Binding FechaEmision, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>


            <!-- ===================================================== -->
            <!-- PESTAÑA 2 - DETALLE DE EXPENSA -->
            <!-- ===================================================== -->

            <TabItem Header="Detalle de Expensas" Padding="10,5">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BÚSQUEDA Y EXPORTACIÓN -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,5,0,15">
                        <TextBlock Text="Período:" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPeriodoDetalle" Width="100" Height="30"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                     Margin="10,0"/>
                        <Button x:Name="BtnBuscarDetalle" Content="Buscar" Width="90" Height="30"
                    Click="BtnBuscarDetalle_Click"/>

                        <Button x:Name="BtnExportarSeleccionado" Content="PDF del seleccionado"
                    Width="150" Height="30" Margin="25,0,0,0"
                    Click="BtnExportarPdfSeleccionado_Click"/>
                        <Button x:Name="BtnExportarTodos" Content="PDF único (todos)"
                    Width="130" Height="30" Margin="8,0,0,0"
                    Click="BtnExportarPdfTodos_Click"/>
                        <Button x:Name="BtnExportarIndividuales" Content="Un PDF por departamento"
                    Width="170" Height="30" Margin="8,0,0,0"
                    Click="BtnExportarIndividuales_Click"/>
                    </WrapPanel>

                    <!-- DETALLE POR DEPARTAMENTO -->
                    <DataGrid x:Name="DgDetalles" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" Background="White" GridLinesVisibility="Horizontal"
                  SelectionChanged="DgDetalles_SelectionChanged">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstaAtrasada}" Value="True">
                                        <Setter Property="Background" Value="#FDECEA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Piso" Binding="{Binding Departamento.Piso}" Width="70"/>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Departamento.Unidad}" Width="70"/>
                            <DataGridTextColumn Header="Monto"
                                    Binding="{Binding MontoAPagar, StringFormat={}{0:C2}, ConverterCulture=es-AR}" Width="130"/>
                            <DataGridTextColumn Header="Vencimiento"
                                    Binding="{Binding FechaVencimiento, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoPago}" Width="100"/>
                            <DataGridTextColumn Header="Fecha Pago"
                                    Binding="{Binding FechaPago, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- REGISTRO DE PAGO (lo completa el encargado) -->
                    <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="LblPagoSeleccion" FontWeight="Bold" Margin="0,0,0,8"
                           Text="Registrar pago: seleccioná un departamento de la tabla"/>

                            <WrapPanel>
                                <StackPanel Margin="0,0,15,0">
                                    <TextBlock Text="Estado" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbEstadoPago" Width="130" Height="28" SelectedIndex="0">
                                        <ComboBoxItem Content="Pendiente"/>
                                        <ComboBoxItem Content="Pagado"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,15,0">
                                    <TextBlock Text="Fecha de pago" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <DatePicker x:Name="DpFechaPago" Width="140" Height="28"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,15,0">
                                    <TextBlock Text="Método de pago" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbMetodoPago" Width="180" Height="28" IsEditable="True">
                                        <ComboBoxItem Content="Efectivo"/>
                                        <ComboBoxItem Content="Transferencia"/>
                                        <ComboBoxItem Content="Tarjeta de débito"/>
                                        <ComboBoxItem Content="Tarjeta de crédito"/>
                                        <ComboBoxItem Content="Cheque"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button x:Name="BtnGuardarPago" Content="Guardar pago" Width="130" Height="28"
                            VerticalAlignment="Bottom" Background="#2C3E50" Foreground="White"
                            FontWeight="Bold" IsEnabled="False" Click="BtnGuardarPago_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================================================== -->
            <!-- PESTAÑA 3 - HISTORIAL DE PROPIETARIOS Y EXPENSAS -->
            <!-- ===================================================== -->

            <TabItem Header="Historial"
                     Padding="10,5">

                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="69*"/>
                        <ColumnDefinition Width="955*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- FILTRO -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,15" Grid.ColumnSpan="2">

                        <TextBlock Text="Departamento:"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="TxtFiltroDepartamento"
                                 Width="130"
                                 Height="30"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="BtnFiltrarHistorial"
                                Content="Filtrar"
                                Width="90"
                                Height="30"
                                Margin="10,0,0,0"
                                Click="BtnFiltrarHistorial_Click"/>

                        <Button x:Name="BtnMostrarTodoHistorial"
                                Content="Mostrar todo"
                                Width="100"
                                Height="30"
                                Margin="10,0,0,0"
                                Click="BtnMostrarTodoHistorial_Click"/>

                    </StackPanel>


                    <!-- HISTORIAL -->
                    <DataGrid x:Name="DgHistorial"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Background="White"
                              GridLinesVisibility="Horizontal" Grid.ColumnSpan="2">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Departamento"
                                                Binding="{Binding IdDepartamento}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Piso"
                                                Binding="{Binding Piso}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Unidad"
                                                Binding="{Binding Unidad}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Propietario"
                                                Binding="{Binding NombrePropietario}"
                                                Width="180"/>

                            <DataGridTextColumn Header="Período"
                                                Binding="{Binding Periodo}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Monto"
                                                Binding="{Binding MontoAPagar, StringFormat={}{0:C2}}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding EstadoPago}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Vencimiento"
                                                Binding="{Binding FechaVencimiento, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Fecha Pago"
                                                Binding="{Binding FechaPago, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Método"
                                                Binding="{Binding MetodoPago}"
                                                Width="120"/>

                            <DataGridTextColumn Header="Desde propietario"
                                                Binding="{Binding FechaDesdePropietario, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="130"/>

                            <DataGridTextColumn Header="Hasta propietario"
                                                Binding="{Binding FechaHastaPropietario, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="130"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Window>