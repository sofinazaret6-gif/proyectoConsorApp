<Window x:Class="consorApp.Views.ReportesEstadisticasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="ConsorApp - Panel de Reportes y Estadísticas" Height="740" Width="1150"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Panel de Reportes y Estadísticas" FontSize="22"
                       FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="Indicadores clave de morosidad, reclamos frecuentes y uso de espacios comunes"
                       FontSize="13" Foreground="#666666" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- SELECTOR DE PERÍODO -->
        <Border Grid.Row="1" Background="#F4F1EE" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Período:" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="#333333" Margin="0,0,10,0"/>
                <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666"/>
                <DatePicker x:Name="DpDesde" Width="130" Height="26"/>
                <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="#666666"/>
                <DatePicker x:Name="DpHasta" Width="130" Height="26"/>
                <Button x:Name="BtnActualizar" Content="🔄 Actualizar" Width="130" Height="28"
                        Margin="18,0,0,0" Background="#A09285" Foreground="White"
                        FontWeight="Bold" Cursor="Hand" Click="BtnActualizar_Click"/>
            </StackPanel>
        </Border>

        <!-- KPIS -->
        <UniformGrid Grid.Row="2" Rows="1" Columns="5" Margin="0,0,0,10">
            <Border Background="#F4F1EE" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Unidades morosas" FontSize="12" Foreground="#7A7A7A"/>
                    <TextBlock x:Name="KpiUnidadesMorosas" Text="—" FontSize="26"
                               FontWeight="Bold" Foreground="#B3413B"/>
                </StackPanel>
            </Border>
            <Border Background="#F4F1EE" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="Deuda total" FontSize="12" Foreground="#7A7A7A"/>
                    <TextBlock x:Name="KpiDeudaTotal" Text="—" FontSize="26"
                               FontWeight="Bold" Foreground="#333333"/>
                </StackPanel>
            </Border>
            <Border Background="#F4F1EE" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="Reclamos pendientes" FontSize="12" Foreground="#7A7A7A"/>
                    <TextBlock x:Name="KpiReclamosPendientes" Text="—" FontSize="26"
                               FontWeight="Bold" Foreground="#C8871E"/>
                </StackPanel>
            </Border>
            <Border Background="#F4F1EE" CornerRadius="8" Padding="14" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="Reservas del período" FontSize="12" Foreground="#7A7A7A"/>
                    <TextBlock x:Name="KpiReservasMes" Text="—" FontSize="26"
                               FontWeight="Bold" Foreground="#3B7D4F"/>
                </StackPanel>
            </Border>
            <Border Background="#F4F1EE" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Gastos del período" FontSize="12" Foreground="#7A7A7A"/>
                    <TextBlock x:Name="KpiGastos" Text="—" FontSize="26" FontWeight="Bold" Foreground="#4A7FB5"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- PESTAÑAS -->
        <TabControl x:Name="TabReportes" Grid.Row="3" Background="White" BorderBrush="#E0E0E0">

            <!-- PESTAÑA 1: MOROSIDAD (Tabla + Gráfico de Torta) -->
            <TabItem Header=" 💰 Morosidad y Deudas " Padding="12,6" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="DgMorosidad" Grid.Column="0"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="70"/>
                            <DataGridTextColumn Header="Propietario" Binding="{Binding Propietario}" Width="*"/>
                            <DataGridTextColumn Header="Deuda" Binding="{Binding Deuda, StringFormat='$ #,0.00', ConverterCulture=es-AR}"/>
                            <DataGridTextColumn Header="Días" Binding="{Binding DiasAtraso}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="8" Padding="10">
                        <lvc:PieChart x:Name="GraficoDeudaPorUnidad" LegendLocation="Bottom" InnerRadius="40">
                            <lvc:PieChart.ChartLegend>
                                <lvc:DefaultLegend Foreground="#333333"/>
                            </lvc:PieChart.ChartLegend>
                        </lvc:PieChart>
                    </Border>
                    <TextBlock x:Name="TxtVacioMorosidad" Grid.ColumnSpan="2"
           Text="No hay expensas impagas y vencidas en el rango seleccionado."
           FontSize="14" Foreground="#888888" IsHitTestVisible="False"
           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: RECLAMOS (Tabla + Gráfico de Torta) -->
            <TabItem Header=" 📋 Reclamos Frecuentes " Padding="12,6" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="DgReclamosEstadisticas" Grid.Column="0"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="150"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalReclamos}" Width="70"/>
                            <DataGridTextColumn Header="Resueltos" Binding="{Binding Resueltos}" Width="80"/>
                            <DataGridTextColumn Header="Pendientes" Binding="{Binding Pendientes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="8" Padding="10">
                        <lvc:PieChart x:Name="GraficoReclamos" LegendLocation="Bottom" InnerRadius="40">
                            <lvc:PieChart.ChartLegend>
                                <lvc:DefaultLegend Foreground="#333333"/>
                            </lvc:PieChart.ChartLegend>
                        </lvc:PieChart>
                    </Border>
                    <TextBlock x:Name="TxtVacioReclamos" Grid.ColumnSpan="2"
           Text="No hay reclamos en el período seleccionado."
           FontSize="14" Foreground="#888888" IsHitTestVisible="False"
           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 3: ESPACIOS COMUNES (Tabla + Gráfico de Torta) -->
            <TabItem Header=" 🏢 Uso de Espacios Comunes " Padding="12,6" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="DgUsoEspacios" Grid.Row="0"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Espacio" Binding="{Binding Espacio}" Width="*"/>
                                <DataGridTextColumn Header="Reservas" Binding="{Binding CantidadReservas}" Width="100"/>
                                <DataGridTextColumn Header="Canceladas" Binding="{Binding ReservasCanceladas}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="Reservas por turno" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DataGrid x:Name="DgFranjas" Height="110"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Turno" Binding="{Binding Franja}" Width="*"/>
                                    <DataGridTextColumn Header="Horario" Binding="{Binding Horario}" Width="120"/>
                                    <DataGridTextColumn Header="Reservas" Binding="{Binding CantidadReservas}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="8" Padding="10">
                        <lvc:PieChart x:Name="GraficoUsoEspacios" LegendLocation="Bottom" InnerRadius="40">
                            <lvc:PieChart.ChartLegend>
                                <lvc:DefaultLegend Foreground="#333333"/>
                            </lvc:PieChart.ChartLegend>
                        </lvc:PieChart>
                    </Border>

                    <TextBlock x:Name="TxtVacioEspacios" Grid.ColumnSpan="2"
                   Text="No hay reservas en el período seleccionado."
                   FontSize="14" Foreground="#888888" IsHitTestVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
            <!-- PESTAÑA 4: GASTOS POR CONCEPTO -->
            <TabItem Header=" 🧾 Gastos por Concepto " Padding="12,6" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="DgGastos" Grid.Column="0"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" Margin="0,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Ranking}" Width="40"/>
                            <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding CantidadGastos}" Width="55"/>
                            <DataGridTextColumn Header="Total"
                    Binding="{Binding TotalGastado, StringFormat='$ #,0.00', ConverterCulture=es-AR}" Width="115"/>
                            <DataGridTextColumn Header="% del total"
                    Binding="{Binding Porcentaje, StringFormat='{}{0:N1} %', ConverterCulture=es-AR}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Background="#F9F9F9" CornerRadius="8" Padding="10">
                        <lvc:PieChart x:Name="GraficoGastos" LegendLocation="Bottom" InnerRadius="40">
                            <lvc:PieChart.ChartLegend>
                                <lvc:DefaultLegend Foreground="#333333"/>
                            </lvc:PieChart.ChartLegend>
                        </lvc:PieChart>
                    </Border>
                </Grid>
            </TabItem>
            <TextBlock x:Name="TxtVacioGastos" Grid.ColumnSpan="2"
           Text="No hay gastos registrados en el período seleccionado."
           FontSize="14" Foreground="#888888" IsHitTestVisible="False"
           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </TabControl>

        <!-- BOTÓN EXPORTAR -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnExportarPdf" Content="📄 Exportar PDF " Width="230"
                    Height="32" Background="#A09285" Foreground="White"
                    FontWeight="Bold" Cursor="Hand" Click="BtnExportarPdf_Click"/>
        </StackPanel>
    </Grid>
</Window>