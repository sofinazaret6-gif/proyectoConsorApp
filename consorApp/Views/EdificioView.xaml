<Window x:Class="consorApp.Views.EdificioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConsorApp - Configuración del Edificio" Height="450" Width="450" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="ColorGrisOscuro" Color="#2E363A"/>
        <SolidColorBrush x:Key="ColorTaupeBronce" Color="#A09285"/>
        <SolidColorBrush x:Key="ColorFondoContenido" Color="#F7F5F2"/>
    </Window.Resources>

    <Grid Background="{StaticResource ColorFondoContenido}">
        <Border Background="White" Margin="20" CornerRadius="8" Padding="20">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="Datos del Edificio" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,0,0,15"/>

                <TextBlock Text="Nombre:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtDescripcion" Margin="0,3,0,10" Height="28"/>

                <TextBlock Text="Ubicación / Dirección:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtUbicacion" Margin="0,3,0,10" Height="28"/>

                <TextBlock Text="Cantidad de Pisos:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtCantPisos" PreviewTextInput="SoloNumeros_PreviewTextInput" Margin="0,3,0,10" Height="28"/>

                <TextBlock Text="Cantidad de Departamentos:" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtCantDepto" PreviewTextInput="SoloNumeros_PreviewTextInput" Margin="0,3,0,15" Height="28"/>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button x:Name="BtnGuardar" Content="Guardar Cambios" Width="130" Height="32" Background="{StaticResource ColorTaupeBronce}" Foreground="White" FontWeight="Bold" Click="BtnGuardar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>