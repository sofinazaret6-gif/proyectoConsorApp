<Window x:Class="consorApp.Views.EdificioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConsorApp - Configuración del Edificio" Height="700" Width="600" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="ColorGrisOscuro" Color="#2E363A"/>
        <SolidColorBrush x:Key="ColorTaupeBronce" Color="#A09285"/>
        <SolidColorBrush x:Key="ColorFondoContenido" Color="#F7F5F2"/>
    </Window.Resources>

    <Grid Background="{StaticResource ColorFondoContenido}">
        <Border Background="White" Margin="15" CornerRadius="8" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Datos del Edificio" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,0,0,10"/>

                    <TextBlock Text="Nombre / Descripción:" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtDescripcion" Margin="0,3,0,8" Height="26"/>

                    <TextBlock Text="Ubicación / Dirección:" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtUbicacion" Margin="0,3,0,8" Height="26"/>

                    <Grid Margin="0,3,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cantidad de Pisos:" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtCantPisos" PreviewTextInput="SoloNumeros_PreviewTextInput" Margin="0,3,0,0" Height="26"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cantidad de Departamentos:" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtCantDepto" PreviewTextInput="SoloNumeros_PreviewTextInput" Margin="0,3,0,0" Height="26"/>
                        </StackPanel>
                    </Grid>

                    <!-- SECCIÓN DE ESPACIOS COMUNES -->
                    <Separator Margin="0,15,0,15"/>
                    <TextBlock Text="Espacios Comunes del Edificio" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Nombre del Espacio:" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtNombreEspacio" Height="26" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Capacidad:" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtCapacidadEspacio" Height="26" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button x:Name="BtnAgregarEspacio" Content="Agregar" Width="80" Height="26" Background="#6C757D" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnAgregarEspacio_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Grilla temporal de espacios comunes a registrar -->
                    <DataGrid x:Name="DgEspaciosComunes" AutoGenerateColumns="False" CanUserAddRows="False" Height="120" Margin="0,0,0,10" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Espacio" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Capacidad" Binding="{Binding Capacidad}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="BtnQuitarEspacio" Content="Quitar Seleccionado" Width="140" Height="24" HorizontalAlignment="Left" Background="#D9534F" Foreground="White" FontSize="11" Cursor="Hand" Click="BtnQuitarEspacio_Click" Margin="0,0,0,15"/>

                    <!-- Botón Guardar General -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnGuardar" Content="Guardar Edificio y Espacios" Width="180" Height="32" Background="{StaticResource ColorTaupeBronce}" Foreground="White" FontWeight="Bold" Click="BtnGuardar_Click" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>