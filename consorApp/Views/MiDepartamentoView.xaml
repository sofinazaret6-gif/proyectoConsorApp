<Window x:Class="consorApp.Views.MiDepartamentoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Mi Departamento - ConsorApp"
        Height="800" Width="950" MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="ColorGrisOscuro" Color="#2E363A"/>
        <SolidColorBrush x:Key="ColorTaupeBronce" Color="#A09285"/>
        <SolidColorBrush x:Key="ColorGrisClaro" Color="#F7F5F2"/>
        <SolidColorBrush x:Key="ColorTextoSecundario" Color="#777777"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Mi Departamento" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}"/>
                <TextBlock Text="Información de la propiedad, propietario, expensas, reservas y estado de tus reclamos." FontSize="13" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border x:Name="BrdEstadoCuenta" Background="#27AE60" CornerRadius="12"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6">
                <TextBlock x:Name="TxtEstadoCuenta" Text="Estado: Al Día"
                           Foreground="White" FontWeight="Bold" FontSize="12"/>
            </Border>
        </Grid>

        <!-- TARJETAS RESUMEN -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">

            <!-- Unidad Funcional -->
            <Border Background="{StaticResource ColorGrisClaro}" CornerRadius="8" Padding="20" Margin="0,0,10,0" BorderBrush="#E5E0DA" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="UNIDAD FUNCIONAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <TextBlock x:Name="TxtUnidad" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtUnidadDetalle" Text="" FontSize="12" Foreground="#888888" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Propietario -->
            <Border Background="{StaticResource ColorGrisClaro}" CornerRadius="8" Padding="20" Margin="5,0,5,0" BorderBrush="#E5E0DA" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="PROPIETARIO REGISTRADO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <TextBlock x:Name="TxtPropietarioNombre" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtPropietarioDni" Text="" FontSize="12" Foreground="#555555" Margin="0,4,0,0"/>
                    <TextBlock x:Name="TxtPropietarioEmail" Text="" FontSize="12" Foreground="#888888" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtPropietarioTelefono" Text="" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Última Expensa -->
            <Border Background="{StaticResource ColorGrisClaro}" CornerRadius="8" Padding="20" Margin="10,0,0,0" BorderBrush="#E5E0DA" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ÚLTIMA EXPENSA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ColorTextoSecundario}"/>
                    <TextBlock x:Name="TxtUltimaExpensaMonto" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TxtUltimaExpensaDetalle" Text="Sin expensas liquidadas" FontSize="12" FontWeight="SemiBold" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- PESTAÑAS -->
        <TabControl Grid.Row="2" Background="White" BorderBrush="#E5E0DA">

            <!-- ===================== MIS EXPENSAS ===================== -->
            <TabItem x:Name="TabExpensas" Header="Mis Expensas" Padding="12,6">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Liquidaciones de tu unidad por período. Podés descargar el detalle de cada una en PDF."
                               FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,12"/>

                    <!-- Aviso de expensas atrasadas (solo si hay) -->
                    <Border Grid.Row="1" x:Name="BrdAvisoAtrasadas" Visibility="Collapsed" Background="#FDECEA"
                            BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <TextBlock x:Name="TxtAvisoAtrasadas" Foreground="#C0392B" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="DgMisExpensas" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstaAtrasada}" Value="True">
                                        <Setter Property="Background" Value="#FDECEA"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="80"/>
                            <DataGridTextColumn Header="Monto"
                                                Binding="{Binding MontoAPagar, StringFormat={}{0:C2}, ConverterCulture=es-AR}" Width="100"/>
                            <DataGridTextColumn Header="Vencimiento"
                                                Binding="{Binding FechaVencimiento, StringFormat={}{0:dd/MM/yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Situación" Binding="{Binding Situacion}" Width="*"/>
                            <DataGridTextColumn Header="Días de atraso" Binding="{Binding DiasAtrasoTexto}" Width="95"/>
                            <DataGridTextColumn Header="Fecha de pago"
                                                Binding="{Binding FechaPago, StringFormat={}{0:dd/MM/yyyy}}" Width="95"/>
                            <DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}" Width="100"/>
                            <DataGridTemplateColumn Header="PDF" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Descargar PDF" Margin="2" Padding="8,2"
                                                Background="#A09285" Foreground="White"
                                                FontWeight="Bold" Cursor="Hand"
                                                Click="BtnDescargarPdf_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== MIS RESERVAS ===================== -->
            <TabItem x:Name="TabReservas" Header="Mis Reservas" Padding="12,6">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Historial y estado actual de las reservas de espacios comunes realizadas por esta unidad."
                               FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" x:Name="DgMisReservas" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Espacio Común" Binding="{Binding Espacio}" Width="*"/>
                            <DataGridTextColumn Header="Fecha de Reserva" Binding="{Binding Fecha}" Width="130"/>
                            <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="180"/>
                            <DataGridTextColumn Header="Estado Actual" Binding="{Binding Estado}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===================== MIS RECLAMOS ===================== -->
            <TabItem x:Name="TabReclamos" Header="Mis Reclamos" Padding="12,6">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Seguimiento de los reportes enviados por este departamento al administrador."
                                   FontSize="12" Foreground="{StaticResource ColorTextoSecundario}"
                                   VerticalAlignment="Center"/>
                        <Button Content="+ Nuevo reclamo" HorizontalAlignment="Right"
                                Width="140" Height="30" Background="#A09285" Foreground="White"
                                FontWeight="Bold" Cursor="Hand" Click="BtnNuevoReclamo_Click"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DgMisReclamos" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="150"/>
                            <DataGridTextColumn Header="Ubicación / Área" Binding="{Binding Ubicacion}" Width="140"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="90"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                            <DataGridTextColumn Header="Observaciones / Respuesta" Binding="{Binding Observacion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>