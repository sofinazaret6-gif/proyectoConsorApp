<Window x:Class="consorApp.Views.AvisosEncargadoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Gestión de Avisos (Encargado) - ConsorApp" 
        Height="720" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="ColorGrisOscuro" Color="#2E363A"/>
        <SolidColorBrush x:Key="ColorTaupeBronce" Color="#A09285"/>
        <SolidColorBrush x:Key="ColorGrisClaro" Color="#F7F5F2"/>
        <SolidColorBrush x:Key="ColorTextoSecundario" Color="#777777"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Formulario de Emisión (Izquierda) -->
            <ColumnDefinition Width="420"/>
            <!-- Historial / Lista de Avisos Enviados (Derecha) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SECCIÓN IZQUIERDA: FORMULARIO PUBLICACIÓN DE AVISO -->
        <Border Grid.Column="0" Background="{StaticResource ColorGrisClaro}" CornerRadius="8" Padding="20" Margin="0,0,15,0" BorderBrush="#E5E0DA" BorderThickness="1">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Nuevo Aviso" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}"/>
                <TextBlock Text="Redacte y publique un comunicado para el edificio o un departamento específico." FontSize="12" Foreground="{StaticResource ColorTextoSecundario}" Margin="0,4,0,15" TextWrapping="Wrap"/>

                <!-- Selector del Destinatario -->
                <TextBlock Text="Destinatario:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbDestinatario" SelectedIndex="0" Padding="8,6" Margin="0,0,0,15" SelectionChanged="CmbDestinatario_SelectionChanged">
                    <ComboBoxItem Content="📢 Aviso General (Todo el Edificio)"/>
                    <ComboBoxItem Content="🏠 Piso 1 - Dpto A"/>
                    <ComboBoxItem Content="🏠 Piso 1 - Dpto B"/>
                    <ComboBoxItem Content="🏠 Piso 2 - Dpto A"/>
                    <ComboBoxItem Content="🏠 Piso 2 - Dpto B"/>
                    <ComboBoxItem Content="🏠 Piso 3 - Dpto A"/>
                    <ComboBoxItem Content="🏠 Piso 4 - Dpto B (Ana Martinez)"/>
                </ComboBox>

                <!-- Título del Aviso -->
                <TextBlock Text="Título del Comunicado:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtTitulo" Padding="8,6" Margin="0,0,0,15" FontSize="13" Text="Ej. Retiro de paquetería en guardia"/>

                <!-- Contenido / Mensaje -->
                <TextBlock Text="Mensaje:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtMensaje" Height="140" Padding="8" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20" FontSize="13"
                         Text="Escriba aquí los detalles del aviso..."/>

                <!-- Botón Publicar -->
                <Border Background="{StaticResource ColorTaupeBronce}" CornerRadius="6" Height="40">
                    <Button Content="Publicar Aviso" Background="Transparent" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- SECCIÓN DERECHA: HISTORIAL DE AVISOS EMITIDOS -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Avisos Publicados Recientemente" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ColorGrisOscuro}" Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">

                    <!-- Item Historial 1 -->
                    <Border Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10" BorderBrush="#E5E0DA" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Background="#E67E22" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="PISO 4 - DPTO B" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="Encomienda recibida en Guardia" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorGrisOscuro}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Señora Ana Martinez, ha ingresado un paquete a su nombre en la recepción..." FontSize="12" Foreground="#555555" Margin="0,6,0,8" TextTrimming="WordEllipsis"/>

                            <Grid Grid.Row="2">
                                <TextBlock Text="Publicado: 23/09/2026 - 15:15 hs" FontSize="11" Foreground="#888888"/>
                                <Button Content="Eliminar" Foreground="#E74C3C" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Item Historial 2 -->
                    <Border Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10" BorderBrush="#E5E0DA" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Background="#A09285" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="GENERAL" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="Corte programado de agua sanitaria" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ColorGrisOscuro}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Estimados vecinos, les informamos que el día de mañana se realizará la limpieza anual..." FontSize="12" Foreground="#555555" Margin="0,6,0,8" TextTrimming="WordEllipsis"/>

                            <Grid Grid.Row="2">
                                <TextBlock Text="Publicado: 22/09/2026 - 10:30 hs" FontSize="11" Foreground="#888888"/>
                                <Button Content="Eliminar" Foreground="#E74C3C" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>