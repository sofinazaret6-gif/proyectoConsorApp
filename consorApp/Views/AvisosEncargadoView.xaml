<Window x:Class="consorApp.Views.AvisosEncargadoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Gestión de Avisos (Encargado) - ConsorApp"
        Height="720"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="ColorGrisOscuro"
                         Color="#2E363A"/>

        <SolidColorBrush x:Key="ColorTaupeBronce"
                         Color="#A09285"/>

        <SolidColorBrush x:Key="ColorGrisClaro"
                         Color="#F7F5F2"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#777777"/>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.ColumnDefinitions>

            <!-- Formulario -->
            <ColumnDefinition Width="420"/>

            <!-- Historial -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- FORMULARIO -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource ColorGrisClaro}"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,15,0"
                BorderBrush="#E5E0DA"
                BorderThickness="1">

            <StackPanel Orientation="Vertical">

                <TextBlock Text="Nuevo Aviso"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource ColorGrisOscuro}"/>

                <TextBlock Text="Redacte y publique un comunicado para todo el edificio o para un departamento específico."
                           FontSize="12"
                           Foreground="{StaticResource ColorTextoSecundario}"
                           Margin="0,4,0,15"
                           TextWrapping="Wrap"/>


                <!-- DESTINATARIO -->

                <TextBlock Text="Destinatario:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorGrisOscuro}"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="CmbDestinatario"
                          Padding="8,6"
                          Margin="0,0,0,15"
                          SelectionChanged="CmbDestinatario_SelectionChanged"/>


                <!-- TÍTULO -->

                <TextBlock Text="Título del Comunicado:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorGrisOscuro}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtTitulo"
                         Padding="8,6"
                         Margin="0,0,0,15"
                         FontSize="13"/>


                <!-- MENSAJE -->

                <TextBlock Text="Mensaje:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorGrisOscuro}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtMensaje"
                         Height="140"
                         Padding="8"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,20"
                         FontSize="13"/>


                <!-- BOTÓN PUBLICAR -->

                <Border Background="{StaticResource ColorTaupeBronce}"
                        CornerRadius="6"
                        Height="40">

                    <Button Content="Publicar Aviso"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnPublicar_Click"/>

                </Border>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- HISTORIAL -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1" Margin="10,0,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título + contador en la misma fila -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Avisos Publicados Recientemente"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource ColorGrisOscuro}"/>

                <TextBlock x:Name="LblCantidad"
                   FontSize="11" Foreground="#888888"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- ================= FILTROS (una sola línea) ================= -->
            <Border Grid.Row="1" Background="{StaticResource ColorGrisClaro}"
            BorderBrush="#E5E0DA" BorderThickness="1"
            CornerRadius="6" Padding="6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buscador con texto de ayuda adentro -->
                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtBuscar" Height="24"
                         VerticalContentAlignment="Center"
                         ToolTip="Busca en título, mensaje y destinatario"
                         TextChanged="Filtro_Changed"/>

                        <TextBlock Text="🔍 Buscar..." IsHitTestVisible="False"
                           Foreground="#999999" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtBuscar}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <ComboBox Grid.Column="1" x:Name="CmbFiltroTipo" Width="115" Height="24"
                      Margin="6,0,0,0" SelectedIndex="0"
                      ToolTip="Filtrar por tipo de aviso"
                      SelectionChanged="Filtro_Changed">
                        <ComboBoxItem Content="Todos los tipos"/>
                        <ComboBoxItem Content="General"/>
                        <ComboBoxItem Content="Individual"/>
                    </ComboBox>

                    <ComboBox Grid.Column="2" x:Name="CmbFiltroEstado" Width="95" Height="24"
                      Margin="6,0,0,0" SelectedIndex="0"
                      ToolTip="Filtrar por estado"
                      SelectionChanged="Filtro_Changed">
                        <ComboBoxItem Content="Vigentes"/>
                        <ComboBoxItem Content="Archivados"/>
                        <ComboBoxItem Content="Todos"/>
                    </ComboBox>

                    <ComboBox Grid.Column="3" x:Name="CmbOrden" Width="90" Height="24"
                      Margin="6,0,0,0" SelectedIndex="0"
                      ToolTip="Ordenar por fecha de publicación"
                      SelectionChanged="Filtro_Changed">
                        <ComboBoxItem Content="Recientes"/>
                        <ComboBoxItem Content="Antiguos"/>
                    </ComboBox>

                    <Button Grid.Column="4" Content="✕" Width="26" Height="24"
                    Margin="6,0,0,0" ToolTip="Limpiar filtros"
                    Click="BtnLimpiarFiltros_Click"/>
                </Grid>
            </Border>

           

            <!-- ================= LISTA ================= -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsAvisos">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <!-- Tarjeta: azul claro = general / naranja claro = individual -->
                            <Border CornerRadius="6" Margin="0,0,0,10" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F3F8FD"/>
                                        <Setter Property="BorderBrush" Value="#C9DCEE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EsGeneral}" Value="False">
                                                <Setter Property="Background" Value="#FFF7EC"/>
                                                <Setter Property="BorderBrush" Value="#F0D3AA"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                <Setter Property="Opacity" Value="0.65"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Franja de color a la izquierda -->
                                    <Border Grid.Column="0" CornerRadius="5,0,0,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#4A7FB5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EsGeneral}" Value="False">
                                                        <Setter Property="Background" Value="#C9822B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Grid Grid.Column="1" Margin="14,12,14,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Etiquetas y título -->
                                        <WrapPanel Grid.Row="0">

                                            <!-- Tipo -->
                                            <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#4A7FB5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsGeneral}" Value="False">
                                                                <Setter Property="Background" Value="#C9822B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TipoTexto}"
                                                   Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Nuevo -->
                                            <Border Background="#27AE60" CornerRadius="4"
                                            Padding="6,2" Margin="0,0,8,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="NUEVO" Foreground="White"
                                                   FontSize="10" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Título -->
                                            <TextBlock Text="{Binding Titulo}"
                                               FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource ColorGrisOscuro}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,4"/>

                                            <!-- Estado -->
                                            <Border Padding="6,2" CornerRadius="4"
                                            Background="#E8E8E8" Margin="0,0,0,4">
                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#666666">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="VIGENTE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                                    <Setter Property="Text" Value="ARCHIVADO"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>

                                        <!-- Destinatario -->
                                        <TextBlock Grid.Row="1" Text="{Binding DestinoTexto}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#4A7FB5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EsGeneral}" Value="False">
                                                            <Setter Property="Foreground" Value="#C9822B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Mensaje -->
                                        <TextBlock Grid.Row="2" Text="{Binding Mensaje}"
                                           FontSize="12" Foreground="#555555"
                                           TextWrapping="Wrap" Margin="0,2,0,10"/>

                                        <!-- Fecha (izquierda) y botón (derecha) en columnas separadas -->
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding FechaTexto}"
                                               FontSize="11" Foreground="#888888"
                                               VerticalAlignment="Center"/>

                                            <Button Grid.Column="1" Click="BtnEliminar_Click"
                                            Tag="{Binding Id}" Padding="12,4">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="Archivar 📁"/>
                                                        <Setter Property="ToolTip" Value="Archivar aviso"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Vigente}" Value="False">
                                                                <Setter Property="Content" Value="Archivado 📁"/>
                                                                <Setter Property="ToolTip" Value="Este aviso ya está archivado"/>
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" x:Name="TxtSinResultados"
               Text="No hay avisos que coincidan con los filtros."
               FontSize="13" Foreground="#888888"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Margin="0,40,0,0" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>