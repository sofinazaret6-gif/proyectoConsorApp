<Window x:Class="consorApp.Views.AvisosEncargadoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Gestión de Avisos (Encargado) - ConsorApp"
        Height="720"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="ColorGrisOscuro"
                         Color="#2E363A"/>

        <SolidColorBrush x:Key="ColorTaupeBronce"
                         Color="#A09285"/>

        <SolidColorBrush x:Key="ColorGrisClaro"
                         Color="#F7F5F2"/>

        <SolidColorBrush x:Key="ColorTextoSecundario"
                         Color="#777777"/>

    </Window.Resources>

    <Grid Margin="20">

        <Grid.ColumnDefinitions>

            <!-- Formulario -->
            <ColumnDefinition Width="420"/>

            <!-- Historial -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- FORMULARIO -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource ColorGrisClaro}"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,15,0"
                BorderBrush="#E5E0DA"
                BorderThickness="1">

            <StackPanel Orientation="Vertical">

                <TextBlock Text="Nuevo Aviso"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource ColorGrisOscuro}"/>

                <TextBlock Text="Redacte y publique un comunicado para todo el edificio o para un departamento específico."
                           FontSize="12"
                           Foreground="{StaticResource ColorTextoSecundario}"
                           Margin="0,4,0,15"
                           TextWrapping="Wrap"/>


                <!-- DESTINATARIO -->

                <TextBlock Text="Destinatario:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorGrisOscuro}"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="CmbDestinatario"
                          Padding="8,6"
                          Margin="0,0,0,15"
                          SelectionChanged="CmbDestinatario_SelectionChanged"/>


                <!-- TÍTULO -->

                <TextBlock Text="Título del Comunicado:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorGrisOscuro}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtTitulo"
                         Padding="8,6"
                         Margin="0,0,0,15"
                         FontSize="13"/>


                <!-- MENSAJE -->

                <TextBlock Text="Mensaje:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ColorGrisOscuro}"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="TxtMensaje"
                         Height="140"
                         Padding="8"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,20"
                         FontSize="13"/>


                <!-- BOTÓN PUBLICAR -->

                <Border Background="{StaticResource ColorTaupeBronce}"
                        CornerRadius="6"
                        Height="40">

                    <Button Content="Publicar Aviso"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="Bold"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="BtnPublicar_Click"/>

                </Border>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- HISTORIAL -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1"
              Margin="10,0,0,0">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0"
                       Text="Avisos Publicados Recientemente"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource ColorGrisOscuro}"
                       Margin="0,0,0,15"/>


            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="ItemsAvisos">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="White"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,0,10"
                                    BorderBrush="#E5E0DA"
                                    BorderThickness="1">

                                <Grid>

                                    <Grid.RowDefinitions>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                        <RowDefinition Height="Auto"/>

                                    </Grid.RowDefinitions>


                                    <!-- TÍTULO Y DESTINATARIO -->

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal">

                                        <Border Background="#A09285"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="0,0,8,0">

                                            <TextBlock Text="AVISO"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>

                                        </Border>

                                        <TextBlock Text="{Binding titulo}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ColorGrisOscuro}"/>

                                    </StackPanel>


                                    <!-- MENSAJE -->

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding mensaje}"
                                               FontSize="12"
                                               Foreground="#555555"
                                               Margin="0,6,0,8"
                                               TextTrimming="WordEllipsis"
                                               TextWrapping="Wrap"/>


                                    <!-- FECHA + ELIMINAR -->

                                    <Grid Grid.Row="2">

                                        <TextBlock Text="{Binding fechaPublicacion, StringFormat='Publicado: {0:dd/MM/yyyy - HH:mm} hs'}"
                                                   FontSize="11"
                                                   Foreground="#888888"/>


                                        <Button Content="Archivar 📁"
                                                 ToolTip="Archivar aviso"
                                                Click="BtnEliminar_Click"
                                            Tag="{Binding id_Aviso}" />

                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>