<Window x:Class="ConsorApp.Views.GestionReservasAdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConsorApp - Administración de Reservas, Bloqueos e Incidentes" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Panel de Control de Administración" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="Gestión de reservas, motivos de cancelación, control de bloqueos y registro de incidentes" FontSize="13" Foreground="#666666" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- CONTROL DE PESTAÑAS -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E0E0E0">

            <!-- PESTAÑA 1: GESTIÓN Y CANCELACIÓN DE RESERVAS -->
            <TabItem Header=" Gestión y Cancelación de Reservas " Padding="12,6" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- FILTROS SUPERIORES -->
                    <Border Grid.Row="0" Background="#F9F9F9" Padding="12" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filtrar por Espacio:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbFiltroEspacio" Width="180" Height="25" Margin="0,0,20,0" SelectionChanged="CmbFiltroEspacio_SelectionChanged"/>

                            <TextBlock Text="Fecha:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker x:Name="DpFiltroFecha" Width="140" Height="25" Margin="0,0,20,0" SelectedDateChanged="DpFiltroFecha_SelectedDateChanged"/>

                            <Button x:Name="BtnLimpiarFiltros" Content="Limpiar Filtros" Width="110" Height="26" Background="#E0E0E0" Foreground="#333" FontWeight="Bold" Cursor="Hand" Click="BtnLimpiarFiltros_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- TABLA / DATAGRID PRINCIPAL -->
                    <DataGrid x:Name="DgReservasAdmin" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdReserva}" Width="40"/>
                            <DataGridTextColumn Header="Espacio Común" Binding="{Binding Espacio}" Width="130"/>
                            <DataGridTextColumn Header="Unidad / Depto" Binding="{Binding Unidad}" Width="90"/>
                            <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="140"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="85"/>
                            <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="110"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                            <DataGridTextColumn Header="Motivo Cancelación" Binding="{Binding MotivoCancelacion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- APARTADO DE MOTIVO DE CANCELACIÓN -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Right">
                        <TextBlock Text="Motivo de Cancelación:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtMotivoCancelacion" Width="300" Height="26" Padding="3" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- BOTÓN DE ACCIÓN INFERIOR -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancelarReserva" Content="Cancelar Reserva Seleccionada" Width="220" Height="32" Background="#6C757D" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCancelarReserva_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: BLOQUEO, MODIFICACIÓN Y VISTA DE PERÍODOS -->
            <TabItem Header=" Bloqueo de Períodos por Mantenimiento " Padding="12,6" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- APARTADO IZQUIERDO: FORMULARIO DE REGISTRO / MODIFICACIÓN -->
                    <Border Grid.Column="0" Background="#FDF2F2" Padding="12" CornerRadius="6" BorderBrush="#F5C6CB" BorderThickness="1" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Registrar o Modificar Bloqueo" FontWeight="Bold" Foreground="#721C24" FontSize="14" Margin="0,0,0,10"/>

                            <TextBlock Text="Espacio:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                            <ComboBox x:Name="CmbEspacioBloqueo" Height="25" Margin="0,0,0,8"/>

                            <TextBlock Text="Desde:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                            <DatePicker x:Name="DpFechaDesde" Height="25" Margin="0,0,0,8"/>

                            <TextBlock Text="Hasta:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                            <DatePicker x:Name="DpFechaHasta" Height="25" Margin="0,0,0,8"/>

                            <TextBlock Text="Motivo:" FontSize="11" Foreground="#555555" Margin="0,0,0,2"/>
                            <TextBox x:Name="TxtMotivoBloqueo" Height="25" Padding="3" Margin="0,0,0,12"/>

                            <!-- Botones de Aplicar Bloqueo y Modificar -->
                            <UniformGrid Columns="2">
                                <Button x:Name="BtnModificarBloqueo" Content="Modificar" Height="28" Background="#F0AD4E" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="0,0,5,0" Click="BtnModificarBloqueo_Click"/>
                                <Button x:Name="BtnBloquearEspacio" Content="Aplicar Bloqueo" Height="28" Background="#D9534F" Foreground="White" FontWeight="Bold" Cursor="Hand" Margin="5,0,0,0" Click="BtnBloquearEspacio_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- APARTADO DERECHO: VISUALIZACIÓN Y ELIMINACIÓN DE BLOQUEOS -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Períodos Bloqueados Activos" FontWeight="Bold" FontSize="13" Foreground="#333333" Margin="0,0,0,8"/>

                        <DataGrid x:Name="DgBloqueosAdmin" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,10" SelectionChanged="DgBloqueosAdmin_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdBloqueo}" Width="40"/>
                                <DataGridTextColumn Header="Espacio" Binding="{Binding Espacio}" Width="120"/>
                                <DataGridTextColumn Header="Desde" Binding="{Binding FechaDesde}" Width="90"/>
                                <DataGridTextColumn Header="Hasta" Binding="{Binding FechaHasta}" Width="90"/>
                                <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnEliminarBloqueo" Content="Eliminar Bloqueo Seleccionado" Width="200" Height="30" Background="#C9302C" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnEliminarBloqueo_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 3: GESTIÓN DE INCIDENTES Y DAÑOS -->
            <TabItem Header=" Incidentes y Daños " Padding="12,6" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SECCIÓN 1: RESERVAS FINALIZADAS DISPONIBLES PARA REPORTAR -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="1. Seleccione una Reserva Finalizada para reportar un daño:" FontWeight="Bold" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>

                        <DataGrid x:Name="DgReservasFinalizadas" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdReserva}" Width="40"/>
                                <DataGridTextColumn Header="Espacio" Binding="{Binding Espacio}" Width="130"/>
                                <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="90"/>
                                <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="140"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="85"/>
                                <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- SECCIÓN 2: FORMULARIO DE DESCRIPCIÓN Y REGISTRO -->
                    <Border Grid.Row="1" Background="#FFF3CD" Padding="10" CornerRadius="6" BorderBrush="#FFEEBA" BorderThickness="1" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Descripción del Daño / Rotura Detectada:" FontWeight="Bold" Foreground="#856404" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtDescripcionIncidente" Height="28" Padding="4"/>
                            </StackPanel>

                            <Button x:Name="BtnRegistrarIncidente" Grid.Column="1" Content="Guardar Incidente" Width="160" Height="30" VerticalAlignment="Bottom" Background="#856404" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnRegistrarIncidente_Click"/>
                        </Grid>
                    </Border>

                    <!-- SECCIÓN 3: HISTORIAL DE INCIDENTES REPORTADOS -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="2. Historial de Incidentes y su Estado:" FontWeight="Bold" FontSize="13" Foreground="#333333" Margin="0,0,0,6"/>

                        <DataGrid x:Name="DgIncidentesAdmin" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID Inc." Binding="{Binding Id_Incidente}" Width="50"/>
                                <DataGridTextColumn Header="Res." Binding="{Binding IdReserva}" Width="45"/>
                                <DataGridTextColumn Header="Espacio" Binding="{Binding Espacio}" Width="120"/>
                                <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="130"/>
                                <DataGridTextColumn Header="Descripción del Daño" Binding="{Binding Descripcion}" Width="*"/>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="85"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnResolverIncidente" Content="Marcar como Solucionado" Width="200" Height="28" Background="#5CB85C" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnResolverIncidente_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>