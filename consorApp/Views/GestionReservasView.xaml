<Window x:Class="ConsorApp.Views.GestionReservasAdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConsorApp - Administración de Reservas" Height="680" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Panel de Control de Reservas" FontSize="22" FontWeight="Bold" Foreground="#333333"/>
            <TextBlock Text="Supervisión, control y bloqueo de espacios comunes del consorcio" FontSize="13" Foreground="#666666" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- FILTROS SUPERIORES -->
        <Border Grid.Row="1" Background="#F9F9F9" Padding="12" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filtrar por Espacio:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbFiltroEspacio" Width="180" Height="25" Margin="0,0,20,0"/>

                <TextBlock Text="Fecha:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker x:Name="DpFiltroFecha" Width="140" Height="25"/>
            </StackPanel>
        </Border>

        <!-- TABLA / DATAGRID PRINCIPAL -->
        <DataGrid x:Name="DgReservasAdmin" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding IdReserva}" Width="40"/>
                <DataGridTextColumn Header="Espacio Común" Binding="{Binding Espacio}" Width="140"/>
                <DataGridTextColumn Header="Unidad / Depto" Binding="{Binding Unidad}" Width="90"/>
                <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="150"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="90"/>
                <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="120"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- APARTADO PARA BLOQUEAR RANGO DE FECHAS -->
        <Border Grid.Row="3" Background="#FDF2F2" Padding="12" CornerRadius="6" BorderBrush="#F5C6CB" BorderThickness="1" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Bloqueo de Espacios por Mantenimiento" FontWeight="Bold" Foreground="#721C24" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Espacio:" FontSize="11" Foreground="#555555"/>
                        <ComboBox x:Name="CmbEspacioBloqueo" Height="25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Desde:" FontSize="11" Foreground="#555555"/>
                        <DatePicker x:Name="DpFechaDesde" Height="25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Hasta:" FontSize="11" Foreground="#555555"/>
                        <DatePicker x:Name="DpFechaHasta" Height="25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Motivo:" FontSize="11" Foreground="#555555"/>
                        <TextBox x:Name="TxtMotivoBloqueo" Height="25" Padding="3"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <!-- EVENTO AGREGADO AQUÍ -->
                        <Button x:Name="BtnBloquearEspacio" Content="Aplicar Bloqueo" Width="120" Height="25" Background="#D9534F" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnBloquearEspacio_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- BOTONES INFERIORES DE ACCIÓN RÁPIDA -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- EVENTO AGREGADO AQUÍ -->
            <Button x:Name="BtnCancelarReserva" Content="Cancelar Reserva Seleccionada" Width="200" Height="32" Background="#6C757D" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCancelarReserva_Click"/>
        </StackPanel>
    </Grid>
</Window>