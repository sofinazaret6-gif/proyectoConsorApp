<Window x:Class="ConsorApp.Vistas.VentanaRespaldos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Respaldos de base de datos - ConsorApp"
        Height="580" Width="940" MinHeight="420" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushFondo}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RespaldosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <TextBlock Text="Respaldos de base de datos"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource BrushPrimario}"/>
            <TextBlock Text="Genera, verifica y resguarda copias de seguridad de la base de datos del consorcio"
                       Foreground="{StaticResource BrushTextoSuave}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Botones -->
        <Border Grid.Row="1" Margin="24,8,24,12" Padding="14"
                Background="{StaticResource BrushTarjeta}"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="1" CornerRadius="8">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnConfig" DockPanel.Dock="Right" Margin="0"
                        Content="Configuración"
                        Style="{StaticResource BotonAccion}"
                        Background="{StaticResource BrushPrimario}"
                        Click="BtnConfig_Click"/>
                <WrapPanel DockPanel.Dock="Left">
                    <Button x:Name="BtnHacer" Content="Hacer backup"
                            Style="{StaticResource BotonAccion}"
                            Background="{StaticResource BrushExito}"
                            Click="BtnHacer_Click"/>
                    <Button x:Name="BtnProbar" Content="Probar backup"
                            Style="{StaticResource BotonAccion}"
                            Background="{StaticResource BrushInfo}"
                            Click="BtnProbar_Click"/>
                    <Button x:Name="BtnResguardar" Content="Resguardar en Drive"
                            Style="{StaticResource BotonAccion}"
                            Background="{StaticResource BrushDrive}"
                            Click="BtnResguardar_Click"/>
                    <Button x:Name="BtnRestaurar" Content="Restaurar"
                            Style="{StaticResource BotonAccion}"
                            Background="{StaticResource BrushPeligro}"
                            Click="BtnRestaurar_Click" RenderTransformOrigin="10.488,32.924"/>
                    <Button x:Name="BtnActualizar" Content="Actualizar"
                            Style="{StaticResource BotonAccion}"
                            Background="{StaticResource BrushInfo}"
                            Click="BtnActualizar_Click"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Lista de respaldos -->
        <Border Grid.Row="2" Margin="24,0,24,12" Padding="1"
                Background="{StaticResource BrushTarjeta}"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="GridRespaldos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BrushBorde}"
                      BorderThickness="0"
                      Background="{StaticResource BrushTarjeta}"
                      RowHeight="36"
                      ColumnHeaderStyle="{StaticResource EncabezadoGrid}"
                      SelectionChanged="GridRespaldos_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Archivo" Width="*"
                                        Binding="{Binding Nombre}"
                                        ElementStyle="{StaticResource CeldaTexto}"/>
                    <DataGridTextColumn Header="Fecha" Width="180"
                                        Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}"
                                        ElementStyle="{StaticResource CeldaTexto}"/>
                    <DataGridTextColumn Header="Tamaño" Width="120"
                                        Binding="{Binding TamanoTexto}"
                                        ElementStyle="{StaticResource CeldaTexto}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Estado -->
        <Border Grid.Row="3" Padding="24,10"
                Background="{StaticResource BrushTarjeta}"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar x:Name="PbOcupado" DockPanel.Dock="Right"
                             Width="160" Height="6" IsIndeterminate="True"
                             Visibility="Collapsed"
                             Foreground="{StaticResource BrushInfo}"/>
                <TextBlock x:Name="TxtEstado" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextoSuave}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
