<Window x:Class="ConsorApp.Vistas.VentanaConfigRespaldos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de respaldos - ConsorApp"
        Height="560" Width="780" MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushFondo}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RespaldosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Configuración de respaldos"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource BrushPrimario}"/>
            <TextBlock Text="Rutas de backup y conexión con Google Drive para resguardar las copias"
                       Foreground="{StaticResource BrushTextoSuave}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Formulario -->
        <Border Grid.Row="1" Padding="20"
                Background="{StaticResource BrushTarjeta}"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Base de datos -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base de datos:" Style="{StaticResource EtiquetaCampo}"/>
                    <TextBox x:Name="TxtBaseDatos" Grid.Row="0" Grid.Column="1" Margin="0,0,0,16"
                             IsReadOnly="True" Background="{StaticResource BrushFondo}"
                             Style="{StaticResource CampoTexto}"/>

                    <!-- Ruta en el servidor -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ruta en el servidor:" Style="{StaticResource EtiquetaCampo}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtRutaServidor" Grid.Column="0" Style="{StaticResource CampoTexto}"/>
                            <Button Grid.Column="1" Content="Examinar..." Margin="8,0,0,0" Padding="12,0" Height="34"
                                    Style="{StaticResource BotonAccion}"
                                    Background="{StaticResource BrushInfo}"
                                    Click="BtnExaminarServidor_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Pista}"
                                   Text="Carpeta donde SQL Server escribe el .bak, vista desde el equipo donde corre SQL Server (ej: C:\ConsorBackups). La cuenta del servicio de SQL Server debe poder escribir ahí."/>
                    </StackPanel>

                    <!-- Ruta compartida -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ruta compartida:" Style="{StaticResource EtiquetaCampo}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtRutaCompartida" Grid.Column="0" Style="{StaticResource CampoTexto}"/>
                            <Button Grid.Column="1" Content="Examinar..." Margin="8,0,0,0" Padding="12,0" Height="34"
                                    Style="{StaticResource BotonAccion}"
                                    Background="{StaticResource BrushInfo}"
                                    Click="BtnExaminarCompartida_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Pista}"
                                   Text="Ruta que usa la app para listar y subir los .bak (ej: \\SERVIDOR\Backups). Si SQL Server está en esta misma PC, dejala vacía y se usa la ruta del servidor."/>
                    </StackPanel>

                    <!-- Google Drive -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Google Drive:" Style="{StaticResource EtiquetaCampo}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnDrive" Content="Conectar con Google Drive" Margin="0,0,12,0"
                                    Style="{StaticResource BotonAccion}"
                                    Background="{StaticResource BrushDrive}"
                                    Click="BtnDrive_Click"/>
                            <TextBlock x:Name="TxtEstadoDrive" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushTexto}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Pista}"
                                   Text="Los respaldos se suben a una carpeta llamada ConsorAppBackups, que la app crea sola en tu Drive. Requiere el archivo google_credentials.json en %AppData%\ConsorApp (ver README)."/>
                    </StackPanel>

                    <!-- Última subida -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Última subida:" Style="{StaticResource EtiquetaCampo}"/>
                    <TextBlock x:Name="TxtUltimaSubida" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="{StaticResource BrushTextoSuave}"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Pie -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Guardar" Style="{StaticResource BotonAccion}"
                    Background="{StaticResource BrushExito}" Click="BtnGuardar_Click"/>
            <Button Content="Cerrar" Style="{StaticResource BotonAccion}" Margin="0"
                    Background="{StaticResource BrushPrimario}" Click="BtnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>
