<Window x:Class="consorApp.Views.NuevoConceptoGastoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo concepto de gasto"
        Height="330"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Nuevo concepto de gasto"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1"
                   Text="Nombre del concepto:"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="TxtNombreConcepto"
                 Grid.Row="2"
                 Height="32"
                 Margin="0,5,0,15"/>

        <TextBlock Grid.Row="3"
                   Text="Descripción:"
                   FontWeight="SemiBold"/>

        <TextBox x:Name="TxtDescripcionConcepto"
                 Grid.Row="4"
                 Height="70"
                 Margin="0,5,0,15"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"/>

        <Button Grid.Row="5"
                Content="GUARDAR CONCEPTO"
                Width="170"
                Height="38"
                HorizontalAlignment="Right"
                Click="BtnGuardarConcepto_Click"/>

    </Grid>

</Window>
