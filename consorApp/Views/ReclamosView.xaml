<Window x:Class="consorApp.Views.ReclamoInquilinoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConsorApp - Registrar Reclamo" Height="480" Width="450"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Border Background="White" Padding="20" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Nuevo Reclamo / Incidente" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" Foreground="#2E363A"/>
                <TextBlock Text="Completá los datos para informar el problema al administrador o encargado." FontSize="12" Foreground="#666666" Margin="0,0,0,20" TextWrapping="Wrap"/>

                <TextBlock Text="Motivo del Reclamo:" FontWeight="SemiBold" Margin="0,0,0,3" Foreground="#444"/>
                <ComboBox x:Name="CmbMotivoReclamo" Height="30" Margin="0,0,0,15">
                    <ComboBoxItem Content="Ruidos molestos" IsSelected="True"/>
                    <ComboBoxItem Content="Gotera / Filtración"/>
                    <ComboBoxItem Content="Basura fuera de horario"/>
                    <ComboBoxItem Content="Problema con ascensor"/>
                    <ComboBoxItem Content="Limpieza en espacios comunes"/>
                    <ComboBoxItem Content="Otro"/>
                </ComboBox>

                <TextBlock Text="Ubicación / Área afectada:" FontWeight="SemiBold" Margin="0,0,0,3" Foreground="#444"/>
                <TextBox x:Name="TxtUbicacion" Height="30" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Descripción detallada:" FontWeight="SemiBold" Margin="0,0,0,3" Foreground="#444"/>
                <TextBox x:Name="TxtDescripcion" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" Padding="5"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancelar" Content="Cancelar" Width="90" Height="32" Background="#E0E0E0" Foreground="#333" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button x:Name="BtnEnviarReclamo" Content="Enviar Reclamo" Width="130" Height="32" Background="#A09285" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
