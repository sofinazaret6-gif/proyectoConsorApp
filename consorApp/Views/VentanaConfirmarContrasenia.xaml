<Window x:Class="ConsorApp.Views.VentanaConfirmarContrasenia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar identidad - ConsorApp"
        Height="440"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushFondo}"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RespaldosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Confirmá tu identidad"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource BrushPrimario}"/>
            <TextBlock Style="{StaticResource Pista}" FontSize="12.5"
                       Text="Restaurar un respaldo reemplaza todos los datos actuales. Para continuar, ingresá tu contraseña."/>
        </StackPanel>

        <!-- Formulario -->
        <Border Grid.Row="1" Padding="20"
                Background="{StaticResource BrushTarjeta}"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="1" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Usuario" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUsuario" Style="{StaticResource CampoTexto}"
                         IsReadOnly="True" Background="#F0F0F0" Margin="0,0,0,14"/>

                <TextBlock Text="Contraseña" Style="{StaticResource EtiquetaCampo}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtPassword" Height="34" Padding="8,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource BrushBorde}" Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtError" Foreground="{StaticResource BrushPeligro}"
                           TextWrapping="Wrap" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Pie -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Confirmar" IsDefault="True" Style="{StaticResource BotonAccion}"
                    Background="{StaticResource BrushPeligro}" Click="BtnConfirmar_Click"/>
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource BotonAccion}" Margin="0"
                    Background="{StaticResource BrushPrimario}" Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
